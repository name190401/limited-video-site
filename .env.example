# ── 日替わりパスワード（Layer2 プラン） ───────────────────────────
# 日替わりロックパスの生成シード。変更すると全日付のパスが変わるため運用開始後は固定。
PASSWORD_SECRET_KEY=your-secret-key-here-change-this

# ── Layer1（サイト共通パスワード） ────────────────────────────────
# これは「settings テーブルに行が無いとき」だけ使われる初期値。
# /admin から一度でも変更すると DB 側（settings.site_password）が正本になり、
# ここを書き換えても反映されない。
SITE_PASSWORD=change-this-site-password

# ── 管理画面 ──────────────────────────────────────────────────────
# SITE_PASSWORD と同じく、/admin から変更したあとは DB 側が正本。
# SITE_PASSWORD と同じ値にしないこと（管理者判定が先に走るため会員ログインが機能しなくなる）。
ADMIN_PASSWORD=your-admin-password

# ── 署名鍵（HMAC・十分長いランダム文字列） ──────────────────────
# Layer1 セッション Cookie 署名用
SESSION_SECRET=generate-a-long-random-string
# Layer2 プラントークン署名用
PLAN_TOKEN_SECRET=generate-another-long-random-string

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service-role キーは server 専用。絶対に NEXT_PUBLIC_ にしない。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# アクセスログは Supabase 接続後に true で有効化する。
ENABLE_ACCESS_LOGS=

# コンテンツの正本を lib/content-local.js にする（true 必須）。
# false にすると Supabase からコンテンツを読むが、DB スキーマは現行構成に
# 追随していない（videos に tab_label 列が無い・compliance/kitamura の
# セクション行が無い）ため旧構成にフォールバックする。
USE_LOCAL_CONTENT=true

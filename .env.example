# ── 入口の日替わりコード ──────────────────────────────────────────
# サイトに入る 6 桁コードの生成シード。**これがサイトの鍵そのもの**。
# 変更すると全日付のコードが一斉に変わる（配布済みが無効になる）ため通常は固定。
PASSWORD_SECRET_KEY=your-secret-key-here-change-this

# ── 管理画面 ──────────────────────────────────────────────────────
# settings.admin_password に行が無いときだけ使う初期値。/admin から変更後は DB 側が正本。
# **8 文字以上にすること**（入口コードは 6 文字。下限が両者の衝突を構造的に防いでいる）。
ADMIN_PASSWORD=your-admin-password

# ── 署名鍵（HMAC・十分長いランダム文字列） ──────────────────────
# セッション Cookie 署名用
SESSION_SECRET=generate-a-long-random-string

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service-role キーは server 専用。絶対に NEXT_PUBLIC_ にしない。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# アクセスログは Supabase 接続後に true で有効化する。
ENABLE_ACCESS_LOGS=

# コンテンツの正本を lib/content-local.js にする（true 必須）。
# false にすると Supabase からコンテンツを読むが、DB スキーマは現行構成に
# 追随していない（videos に tab_label 列が無い・compliance/kitamura の
# セクション行が無い）ため旧構成にフォールバックする。
USE_LOCAL_CONTENT=true
